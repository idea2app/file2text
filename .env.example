# Only Markdown conversion needs an AI model and AI Gateway credentials.
MEDIA_AI_MODEL=google/gemini-2.5-flash
AI_GATEWAY_API_KEY=

# Optional HTTP(S) proxy. NO_PROXY is honored.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional local directory or URL containing chi_tra/chi_sim/eng.traineddata.gz.
# TESSDATA_PREFIX=/path/to/tessdata
